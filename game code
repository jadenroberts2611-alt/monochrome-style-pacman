<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Monochrome Pac-Man</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
:root{--bg:#000;--fg:#fff;--dim:#999;color-scheme:dark;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--fg)}
body{font-family:'Press Start 2P',ui-monospace,monospace;min-height:100dvh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:12px;user-select:none;-webkit-user-select:none}
h1{font-size:clamp(14px,4vw,26px);margin:0;letter-spacing:.15em}
.hud{display:flex;gap:16px;font-size:clamp(8px,2.2vw,12px);flex-wrap:wrap;justify-content:center}
.hud b{font-weight:400}
.stage{position:relative;width:min(100%,448px);border:4px solid var(--fg);padding:6px;background:#000}
canvas{display:block;width:100%;height:auto;image-rendering:pixelated;touch-action:none}
.stage::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.18) 0 1px,transparent 1px 3px)}
#ov{position:absolute;inset:0;z-index:2;background:rgba(0,0,0,.92);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:16px;text-align:center}
#ov h2{margin:0;font-size:clamp(16px,5vw,24px)}
#ov p{font-size:10px;line-height:2;color:var(--dim);margin:0}
button{font:inherit;background:#000;color:#fff;border:3px solid #fff;padding:12px 18px;cursor:pointer;font-size:11px}
button:hover,button:active{background:#fff;color:#000}
.pad{display:grid;grid-template-columns:repeat(3,56px);gap:6px}
.pad button{padding:0;height:56px;font-size:18px}
@media (hover:hover) and (pointer:fine){.pad{display:none}}
</style>
</head>
<body>
<h1>PAC-MAN</h1>
<div class="hud"><span>SCORE <b id="sc">0</b></span><span>HIGH <b id="hi">0</b></span><span>LEVEL <b id="lv">1</b></span><span>LIVES <b id="li">3</b></span></div>
<div class="stage">
  <canvas id="c" width="448" height="496"></canvas>
  <div id="ov"><h2 id="ot">READY?</h2><p id="od">ARROWS / WASD / SWIPE TO MOVE<br>P = PAUSE &nbsp; M = MUTE<br>EAT ALL DOTS, AVOID GHOSTS</p><button id="go">START GAME</button></div>
</div>
<nav class="pad" aria-label="Touch controls"><i></i><button data-d="0">▲</button><i></i><button data-d="3">◀</button><button data-d="2">▼</button><button data-d="1">▶</button></nav>

<script>
const T=16,COLS=28,ROWS=31,W=COLS*T,H=ROWS*T,TUN=14;
// # wall, . dot, o power pellet, - ghost gate, space = empty
const LAYOUT=[
'############################',
'#............##............#',
'#.####.#####.##.#####.####.#',
'#o####.#####.##.#####.####o#',
'#.####.#####.##.#####.####.#',
'#..........................#',
'#.####.##.########.##.####.#',
'#.####.##.########.##.####.#',
'#......##....##....##......#',
'######.##### ## #####.######',
'######.##### ## #####.######',
'######.##          ##.######',
'######.## ###--### ##.######',
'######.## #      # ##.######',
'      .   #      #   .      ',
'######.## #      # ##.######',
'######.## ######## ##.######',
'######.##          ##.######',
'######.## ######## ##.######',
'######.## ######## ##.######',
'#............##............#',
'#.####.#####.##.#####.####.#',
'#.####.#####.##.#####.####.#',
'#o..##.......  .......##..o#',
'###.##.##.########.##.##.###',
'###.##.##.########.##.##.###',
'#......##....##....##......#',
'#.##########.##.##########.#',
'#.##########.##.##########.#',
'#..........................#',
'############################'];
const DIRS=[[0,-1],[1,0],[0,1],[-1,0]]; // up right down left
const SCHED=[420,1200,420,1200,300,Infinity]; // scatter/chase (ticks @60Hz)
const $=i=>document.getElementById(i);
const cv=$('c'),ctx=cv.getContext('2d'),ov=$('ov');

let grid,dots,score=0,lives=3,lvl=1,high=0,bonus=false,state='title',stT=0,paused=false,frame=0;
let frightT=0,frightDur=420,combo=0,modeI=0,modeT=0,popups=[],mz,wk=false,mute=false,AC;
try{high=+localStorage.getItem('pacman_mono_high')||0}catch(e){}

const pac={x:224,y:376,dir:3,next:-1,acc:0,anim:0,moved:false};
const GH=[
 {id:0,shade:'#fff',corner:[25,-3],wait:0},
 {id:1,shade:'#bbb',corner:[2,-3],wait:60},
 {id:2,shade:'#888',corner:[27,31],wait:200},
 {id:3,shade:'#666',corner:[0,31],wait:340}];
const ghosts=GH.map(g=>({...g,x:0,y:0,dir:3,acc:0,fr:false,mode:'house',t:0}));

/* ---------- helpers ---------- */
const tc=v=>Math.floor(v/T);
const atC=e=>((e.x%T)+T)%T===8&&((e.y%T)+T)%T===8;
function tile(c,r){if(r<0||r>=ROWS)return'#';if(c<0||c>=COLS)return r===TUN?' ':'#';return grid[r][c]}
const solid=(c,r)=>{const t=tile(c,r);return t==='#'||t==='-'};
function wrap(e){if(e.x<-8)e.x+=W+16;else if(e.x>W+8)e.x-=W+16}
function beep(f,d=.06,type='square',v=.04){
  if(mute)return;
  try{AC=AC||new(window.AudioContext||window.webkitAudioContext)();
    const o=AC.createOscillator(),g=AC.createGain();o.type=type;o.frequency.value=f;g.gain.value=v;
    o.connect(g);g.connect(AC.destination);o.start();o.stop(AC.currentTime+d)}catch(e){}
}
function hud(){$('sc').textContent=score;$('hi').textContent=high;$('lv').textContent=lvl;$('li').textContent=lives}
function add(n){score+=n;if(score>high)high=score;if(!bonus&&score>=10000){bonus=true;lives++;beep(880,.3)}hud()}
function show(t,d,b){$('ot').textContent=t;$('od').innerHTML=d;$('go').textContent=b;ov.style.display='flex'}

/* ---------- setup ---------- */
function resetPositions(){
  Object.assign(pac,{x:224,y:376,dir:3,next:-1,acc:0,anim:0,moved:false});
  const S=[[224,184],[224,232],[200,232],[248,232]];
  ghosts.forEach((g,i)=>Object.assign(g,{x:S[i][0],y:S[i][1],dir:3,acc:0,fr:false,mode:i?'house':'out',t:Math.max(0,GH[i].wait-(lvl-1)*20)}));
  frightT=0;modeI=modeT=0;popups=[];
}
function loadLevel(){
  grid=LAYOUT.map(r=>[...r]);dots=0;
  grid.forEach(r=>r.forEach(c=>{if(c==='.'||c==='o')dots++}));
  frightDur=Math.max(120,420-(lvl-1)*45);
  resetPositions();
}
function newGame(){score=0;lives=3;lvl=1;bonus=false;paused=false;loadLevel();hud();state='ready';stT=120}
function start(){if(state!=='title'&&state!=='over')return;ov.style.display='none';newGame()}
function gameOver(){
  state='over';
  try{localStorage.setItem('pacman_mono_high',high)}catch(e){}
  show('GAME OVER','SCORE '+score+'<br>HIGH '+high,'PLAY AGAIN');
}
function buildMaze(){
  mz=document.createElement('canvas');mz.width=W;mz.height=H;
  const m=mz.getContext('2d'),wl=(c,r)=>!!LAYOUT[r]&&LAYOUT[r][c]==='#';
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
    if(!wl(c,r))continue;
    const x=c*T,y=r*T,L=wl(c-1,r),R=wl(c+1,r),U=wl(c,r-1),D=wl(c,r+1);
    m.fillStyle='#fff';m.fillRect(x,y,T,T);
    m.fillStyle='#000'; // carve hollow interior so walls read as outlines
    m.fillRect(x+3-(L?3:0),y+3,10+(L?3:0)+(R?3:0),10);
    m.fillRect(x+3,y+3-(U?3:0),10,10+(U?3:0)+(D?3:0));
    if(L&&U&&wl(c-1,r-1))m.fillRect(x,y,3,3);
    if(R&&U&&wl(c+1,r-1))m.fillRect(x+13,y,3,3);
    if(L&&D&&wl(c-1,r+1))m.fillRect(x,y+13,3,3);
    if(R&&D&&wl(c+1,r+1))m.fillRect(x+13,y+13,3,3);
  }
  m.fillStyle='#888';m.fillRect(13*T,12*T+6,2*T,3);
}

/* ---------- movement ---------- */
function stepPac(){
  const p=pac;
  if(p.next>=0&&p.next===(p.dir+2)%4)p.dir=p.next; // instant reverse
  if(atC(p)){
    const c=tc(p.x),r=tc(p.y);
    if(p.next>=0&&!solid(c+DIRS[p.next][0],r+DIRS[p.next][1]))p.dir=p.next;
    if(solid(c+DIRS[p.dir][0],r+DIRS[p.dir][1]))return false;
  }
  p.x+=DIRS[p.dir][0];p.y+=DIRS[p.dir][1];wrap(p);return true;
}
function target(g){
  if(g.mode==='eyes')return[13,11];
  if(modeI%2===0)return g.corner;
  const pc=tc(pac.x),pr=tc(pac.y),d=DIRS[pac.dir];
  if(g.id===0)return[pc,pr];
  if(g.id===1)return[pc+d[0]*4,pr+d[1]*4];
  if(g.id===2){const b=ghosts[0];return[2*(pc+d[0]*2)-tc(b.x),2*(pr+d[1]*2)-tc(b.y)]}
  return Math.hypot(pc-tc(g.x),pr-tc(g.y))>8?[pc,pr]:g.corner;
}
function stepGhost(g){
  const m=g.mode;
  if(m==='house')return;
  if(m==='leave'){
    if(g.x<224)g.x++;else if(g.x>224)g.x--;else if(g.y>184)g.y--;else{g.mode='out';g.dir=Math.random()<.5?1:3}
    return;
  }
  if(m==='enter'){
    if(g.x<224)g.x++;else if(g.x>224)g.x--;else if(g.y<232)g.y++;else g.mode='leave';
    return;
  }
  if(atC(g)){
    const c=tc(g.x),r=tc(g.y);
    if(m==='eyes'&&r===11&&(c===13||c===14)){g.mode='enter';return}
    const opts=[];
    for(const i of[0,3,2,1]){if(i!==(g.dir+2)%4&&!solid(c+DIRS[i][0],r+DIRS[i][1]))opts.push(i)}
    if(!opts.length)opts.push((g.dir+2)%4);
    if(g.fr)g.dir=opts[Math.random()*opts.length|0];
    else{
      const t=target(g);let bd=1e9;
      for(const i of opts){const d=(c+DIRS[i][0]-t[0])**2+(r+DIRS[i][1]-t[1])**2;if(d<bd){bd=d;g.dir=i}}
    }
  }
  g.x+=DIRS[g.dir][0];g.y+=DIRS[g.dir][1];wrap(g);
}
function eat(){
  const c=tc(pac.x),r=tc(pac.y),t=grid[r]&&grid[r][c];
  if(t!=='.'&&t!=='o')return;
  grid[r][c]=' ';dots--;
  if(t==='.'){add(10);wk=!wk;beep(wk?240:170,.05)}
  else{
    add(50);frightT=frightDur;combo=0;beep(90,.2,'sawtooth');
    ghosts.forEach(g=>{if(g.mode==='eyes'||g.mode==='enter')return;if(!g.fr&&g.mode==='out')g.dir=(g.dir+2)%4;g.fr=true});
  }
  if(dots<=0){state='clear';stT=120}
}
function die(){
  state='dying';stT=0;
  for(let i=0;i<6;i++)setTimeout(()=>beep(420-i*55,.1,'triangle'),i*110);
}
function play(){
  if(frightT>0){if(--frightT===0)ghosts.forEach(g=>g.fr=false)}
  else if(++modeT>=SCHED[modeI]){modeT=0;modeI++;ghosts.forEach(g=>{if(g.mode==='out')g.dir=(g.dir+2)%4})}
  pac.acc+=1.6;pac.moved=false;
  while(pac.acc>=1){pac.acc--;if(stepPac())pac.moved=true}
  if(pac.moved)pac.anim+=.35;
  eat();
  if(state!=='play')return;
  const base=1.4+Math.min(lvl-1,8)*.03;
  for(const g of ghosts){
    let sp=base;const m=g.mode;
    if(m==='eyes'||m==='enter')sp=3;
    else if(m==='house'){if(--g.t<=0)g.mode='leave';sp=0}
    else if(m==='leave')sp=.9;
    else{if(g.fr)sp*=.6;if(tc(g.y)===TUN&&(g.x<6*T||g.x>22*T))sp*=.55}
    g.acc+=sp;while(g.acc>=1){g.acc--;stepGhost(g)}
    if(g.mode==='eyes'||g.mode==='enter'||g.mode==='house')continue;
    if(Math.hypot(g.x-pac.x,g.y-pac.y)<10){
      if(g.fr){
        g.fr=false;g.mode='eyes';const v=200<<Math.min(combo++,3);
        add(v);popups.push({x:g.x,y:g.y,t:50,s:v});beep(600,.15,'sawtooth');
      }else{die();return}
    }
  }
}
function tick(){
  frame++;
  if(paused||state==='title'||state==='over')return;
  popups.forEach(p=>{p.t--;p.y-=.3});popups=popups.filter(p=>p.t>0);
  if(state==='ready'){if(--stT<=0)state='play'}
  else if(state==='play')play();
  else if(state==='dying'){
    if(++stT>=100){lives--;hud();if(lives<=0)gameOver();else{resetPositions();state='ready';stT=100}}
  }else if(state==='clear'){
    if(--stT<=0){lvl++;loadLevel();hud();state='ready';stT=120}
  }
}

/* ---------- drawing ---------- */
const TAU=Math.PI*2;
function drawGhost(g){
  ctx.save();
  ctx.translate(g.x,g.y+(g.mode==='house'?Math.round(Math.sin(frame/8)*3):0));
  const eo=g.mode==='eyes'||g.mode==='enter',flash=g.fr&&frightT<120&&((frame>>3)&1);
  if(!eo){
    ctx.beginPath();ctx.arc(0,-1,7.5,Math.PI,0);ctx.lineTo(7.5,7);
    const f=(frame>>3)&1;
    for(let i=0;i<=6;i++)ctx.lineTo(7.5-i*2.5,7-((i+f)&1)*3);
    ctx.closePath();
    if(g.fr){ctx.fillStyle=flash?'#fff':'#000';ctx.fill();ctx.lineWidth=1.5;ctx.strokeStyle='#fff';ctx.stroke()}
    else{ctx.fillStyle=g.shade;ctx.fill()}
  }
  if(g.fr&&!eo){
    ctx.fillStyle=ctx.strokeStyle=flash?'#000':'#fff';
    ctx.fillRect(-3.5,-3,2,2);ctx.fillRect(1.5,-3,2,2);
    ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(-5,3);
    for(let i=1;i<=5;i++)ctx.lineTo(-5+i*2,3+(i&1?-1.5:0));
    ctx.stroke();
  }else{
    const d=DIRS[g.dir];
    for(const ex of[-3,3]){
      ctx.fillStyle='#000';ctx.beginPath();ctx.arc(ex,-2,3.2,0,TAU);ctx.fill();
      ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(ex,-2,2.3,0,TAU);ctx.fill();
      ctx.fillStyle='#000';ctx.fillRect(ex+d[0]*1.2-.8,-2+d[1]*1.2-.8,1.6,1.6);
    }
  }
  ctx.restore();
}
function drawPac(){
  ctx.save();ctx.translate(pac.x,pac.y);ctx.fillStyle='#fff';ctx.beginPath();
  if(state==='dying'){
    if(stT<90){
      const a=.2+(stT/90)*(Math.PI-.2);
      ctx.rotate(-Math.PI/2);ctx.moveTo(0,0);ctx.arc(0,0,7.5,a,TAU-a);ctx.fill();
    }
  }else{
    const m=state==='ready'?.01:(.03+Math.abs(Math.sin(pac.anim))*.25)*Math.PI;
    ctx.rotate((pac.dir-1)*Math.PI/2);ctx.moveTo(0,0);ctx.arc(0,0,7.5,m,TAU-m);ctx.fill();
  }
  ctx.restore();
}
function draw(){
  ctx.fillStyle='#000';ctx.fillRect(0,0,W,H);
  ctx.drawImage(mz,0,0);
  ctx.fillStyle='#fff';
  const blink=(frame>>4)&1;
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
    const t=grid[r][c];
    if(t==='.')ctx.fillRect(c*T+6,r*T+6,4,4);
    else if(t==='o'&&!blink){ctx.beginPath();ctx.arc(c*T+8,r*T+8,6,0,TAU);ctx.fill()}
  }
  drawPac();
  if(state!=='clear'&&!(state==='dying'&&stT>20))ghosts.forEach(drawGhost);
  ctx.fillStyle='#fff';ctx.textAlign='center';
  ctx.font='8px "Press Start 2P",monospace';
  popups.forEach(p=>ctx.fillText(p.s,p.x,p.y));
  ctx.font='12px "Press Start 2P",monospace';
  if(paused)ctx.fillText('PAUSED',W/2,17*T+13);
  else if(state==='ready')ctx.fillText('READY!',W/2,17*T+13);
  if(state==='clear'&&((stT>>3)&1)){ // level-clear invert flash
    ctx.globalCompositeOperation='difference';ctx.fillRect(0,0,W,H);ctx.globalCompositeOperation='source-over';
  }
}

/* ---------- loop ---------- */
let last=0,acc=0;
function loop(ts){
  if(!last)last=ts;
  acc+=Math.min(ts-last,100);last=ts;
  while(acc>=1000/60){tick();acc-=1000/60} // fixed 60Hz: same speed on any display
  draw();requestAnimationFrame(loop);
}

/* ---------- input ---------- */
const KEYS={ArrowUp:0,w:0,W:0,ArrowRight:1,d:1,D:1,ArrowDown:2,s:2,S:2,ArrowLeft:3,a:3,A:3};
function togglePause(){if(state!=='title'&&state!=='over')paused=!paused}
addEventListener('keydown',e=>{
  if(KEYS[e.key]!==undefined){e.preventDefault();pac.next=KEYS[e.key];return}
  if(e.key==='Enter'||e.key===' '){e.preventDefault();if(state==='title'||state==='over')start();else togglePause()}
  else if(e.key==='p'||e.key==='P'||e.key==='Escape')togglePause();
  else if(e.key==='m'||e.key==='M')mute=!mute;
});
$('go').addEventListener('click',start);
document.querySelectorAll('.pad button').forEach(b=>b.addEventListener('pointerdown',e=>{e.preventDefault();pac.next=+b.dataset.d}));
let sx=0,sy=0;
cv.addEventListener('touchstart',e=>{sx=e.touches[0].clientX;sy=e.touches[0].clientY},{passive:true});
cv.addEventListener('touchend',e=>{
  const t=e.changedTouches[0],dx=t.clientX-sx,dy=t.clientY-sy;
  if(Math.max(Math.abs(dx),Math.abs(dy))<20)return;
  pac.next=Math.abs(dx)>Math.abs(dy)?(dx>0?1:3):(dy>0?2:0);
},{passive:true});
document.addEventListener('visibilitychange',()=>{if(document.hidden&&(state==='play'||state==='ready'))paused=true});

loadLevel();hud();buildMaze();requestAnimationFrame(loop);
</script>
</body>
</html>